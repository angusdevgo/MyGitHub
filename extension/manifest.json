{
  "manifest_version": 3,
  "name": "MyGitHub 跨设备 2FA 助手",
  "version": "1.0.0",
  "description": "配合 MyGitHub 手机端实现 GitHub 登录与 Sudo 模式的无缝两位数字跨设备批准，免输 6 位动态码。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MyGitHub 2FA"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://*.workers.dev/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/sessions/two-factor*",
        "https://github.com/sessions/verified-device*",
        "https://github.com/sessions/sudo*"
      ],
      "js": [
        "crypto/noble_ed25519_min.js",
        "content/github_interceptor.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
